# --- Server (src/server.ts) ---
# Network: "mainnet" settles in USAT on Celo mainnet, anything else = Celo Sepolia testnet (USDC)
X402_NETWORK=testnet
# Facilitator API key from https://x402.celo.org (required unless X402_DEMO=1)
X402_API_KEY=
# Your wallet address that receives payments (required unless X402_DEMO=1)
SELLER_PAY_TO=
# Set to 1 to run in demo mode: no secrets needed, paid routes served free, flagged demo:true
# X402_DEMO=1
PORT=3000
# Public origin of the deployed app, used in discovery files and keep-warm pings (e.g. https://naira-rates-api.onrender.com)
PUBLIC_URL=
# ERC-8004 agent id after onchain registration (optional, added to /.well-known/agent-registration.json)
ERC8004_AGENT_ID=

# --- Test buyer (src/buyer.ts) ---
# 64 hex digits, 0x optional. Pays for one /v1/rates call.
BUYER_PRIVATE_KEY=
# API base the buyer pays (default http://localhost:3000)
API_URL=

# --- Onchain registration (src/register-8004.ts) ---
# 64 hex digits, 0x optional. Owner of the ERC-8004 identity. COSTS GAS with --send.
OWNER_PRIVATE_KEY=
# celo_... attribution code from Loops House enrollment
ATTRIBUTION_CODE=
# Public URL of your agent-registration.json (must be reachable, x402Support: true)
AGENT_URI=
